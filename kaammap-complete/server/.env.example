# KAAMMAP server environment — copy to .env and fill in real values.
# NEVER commit a real .env file. NEVER put these values in frontend code.

# --- Required ---
# MongoDB connection string (Atlas: mongodb+srv://<user>:<pass>@<cluster>/kaammap?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/kaammap
# Secrets for signing JWT access tokens / refresh handling. Use long random strings (32+ chars).
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# --- Optional (defaults shown) ---
NODE_ENV=development
PORT=5000
# Frontend origin allowed by CORS (comma-separated for multiple). Must match the deployed frontend origin in production.
CLIENT_ORIGIN=http://localhost:5173
# Public base URL of this API (used in email links)
APP_BASE_URL=http://localhost:5000
# Public base URL of the frontend (used in password-reset / verification links in emails)
CLIENT_BASE_URL=http://localhost:5173
# Serve Swagger UI at /api/docs even in production when true (default: only outside production)
ENABLE_SWAGGER=false

# --- Email (SMTP) — if SMTP_HOST is empty, the server runs in DEV EMAIL MODE:
# emails are logged to the server console instead of sent, and auth endpoints
# return a `devToken` field in responses (NEVER in production). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="KAAMMAP <no-reply@example.com>"

# --- Seed-time admin (used ONLY by `npm run seed`; not used by the running server) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Required to run the seed when NODE_ENV=production
SEED_CONFIRM=
